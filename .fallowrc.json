{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["harness/main.ts"],
  "supportEntry": [
    "scripts/*.mjs",
    "*.config.ts",
    "*.config.mjs",
    "vite.*.ts",
    "vitest.*.ts",
    "tests/**/*.test.ts"
  ],
  "ignorePatterns": [
    "docs/**",
    ".claude/**",
    "skills/**",
    "reports/**",
    "release/**",
    ".stryker-tmp/**",
    ".superpowers/**"
  ],
  "duplicates": {
    "minTokens": 50
  },
  "health": {
    "maxCyclomatic": 10
  },
  "boundaries": {
    "zones": [
      {
        "name": "domain",
        "patterns": ["src/domain/**"]
      },
      {
        "name": "application",
        "patterns": ["src/application/**"]
      },
      {
        "name": "infrastructure",
        "patterns": ["src/infrastructure/**"]
      },
      {
        "name": "presentation",
        "patterns": ["src/presentation/**"]
      },
      {
        "name": "composition",
        "patterns": ["src/main.ts", "src/bootstrap.ts"]
      }
    ],
    "rules": [
      {
        "from": "domain",
        "allow": []
      },
      {
        "from": "application",
        "allow": ["domain"]
      },
      {
        "from": "infrastructure",
        "allow": ["application", "domain", "presentation"]
      },
      {
        "from": "presentation",
        "allow": ["application", "domain"]
      },
      {
        "from": "composition",
        "allow": ["infrastructure", "application", "domain", "presentation"]
      }
    ]
  },
  "ignoreDependencies": ["obsidian", "@iconify-json/lucide", "@eslint/js"],
  "overrides": [
    {
      "files": ["tests/support/obsidian/**"],
      "rules": {
        "unused-class-members": "off"
      }
    }
  ]
}
