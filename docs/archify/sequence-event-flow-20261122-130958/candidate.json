  "cards": [
    {
      "dot": "violet",
      "title": "Gating",
      "items": [
        "File events before onLayoutReady are dropped",
        "LayoutReady is the first event of every load, VaultReady the second",
        "The index builds at VaultReady and ignores everything before it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "Unbounded PubSub: no event is lost in a bulk sync",
        "Each subscriber has its own subscription",
        "The index follows by re-reading paths, never by applying a delta"
      ]
    },
    {
      "dot": "amber",
      "title": "Own writes",
      "items": [
        "A write by the plugin does not notify the index",
        "It arrives the same way as an outside edit, through MetadataChanged",
        "The view waits for that event, like every other view"
      ]
    },
    {
      "dot": "rose",
      "title": "Clean-up",
      "items": [
        "Closing the view interrupts its stream",
        "Disposing the runtime removes all 6 listeners and stops the index"
      ]
    }
  ]
