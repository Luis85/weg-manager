{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "*.mjs",
    "../*.mjs",
    "../scripts/**/*.mjs",
    "../skills/src/**/*.ts",
    "../skills/tests/**/*.ts"
  ]
}
