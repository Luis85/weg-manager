{
  "$schema": "../node_modules/fallow/schema.json",
  "entry": ["harness/main.ts"],
  "supportEntry": [
    "scripts/*.mjs",
    "tests/**/*.test.ts",
    "tests/e2e/**/*.ts",
    "tests/e2e/wdio.conf.mts",
    "configs/*.ts",
    "configs/*.mjs",
    "*.config.mjs"
  ],
  "ignorePatterns": [
    "docs/**",
    ".claude/**",
    "reports/**",
    "release/**",
    ".stryker-tmp/**",
    ".superpowers/**",
    ".obsidian-cache/**"
  ],
  "duplicates": {
    "minTokens": 50
  },
  "health": {
    "maxCyclomatic": 10
  },
  "boundaries": {
    "zones": [
      {
        "name": "domain",
        "patterns": ["src/domain/**"]
      },
      {
        "name": "application",
        "patterns": ["src/application/**"]
      },
      {
        "name": "infrastructure",
        "patterns": ["src/infrastructure/**"]
      },
      {
        "name": "presentation",
        "patterns": ["src/presentation/**"]
      },
      {
        "name": "composition",
        "patterns": ["src/main.ts", "src/bootstrap.ts"]
      }
    ],
    "rules": [
      {
        "from": "domain",
        "allow": []
      },
      {
        "from": "application",
        "allow": ["domain"]
      },
      {
        "from": "infrastructure",
        "allow": ["application", "domain", "presentation"]
      },
      {
        "from": "presentation",
        "allow": ["application", "domain"]
      },
      {
        "from": "composition",
        "allow": ["infrastructure", "application", "domain", "presentation"]
      }
    ]
  },
  "ignoreDependencies": [
    "obsidian",
    "@iconify-json/lucide",
    "@eslint/js",
    "wdio-obsidian-reporter",
    "@wdio/local-runner",
    "@wdio/mocha-framework"
  ],
  "overrides": [
    {
      "files": ["tests/support/obsidian/**"],
      "rules": {
        "unused-class-members": "off"
      }
    }
  ]
}
