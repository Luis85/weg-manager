{
  "name": "weg-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keep the communities of a German condominium (WEG) advisory board as notes in your vault.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "vue-tsc -p configs/tsconfig.app.json && vue-tsc -p configs/tsconfig.node.json && tsc -p tests/e2e/tsconfig.json",
    "lint": "npm run lint:ox && npm run lint:es",
    "lint:ox": "oxlint --deny-warnings",
    "lint:es": "eslint --max-warnings 0 .",
    "lint:scanner": "eslint --config configs/eslint.scanner.config.mjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config configs/vitest.config.ts",
    "test:coverage": "vitest run --config configs/vitest.config.ts --coverage",
    "analyze": "fallow -c configs/fallow.json && fallow architecture -c configs/fallow.json",
    "build": "vite build --config configs/vite.config.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "dev": "node scripts/dev-install.mjs",
    "dev:ui": "vite --config configs/vite.harness.config.ts",
    "build:ui": "vite build --config configs/vite.harness.config.ts",
    "test:mutation": "stryker run configs/stryker.config.mjs",
    "test:mutation:full": "stryker run configs/stryker.config.mjs --force",
    "test:mutation:edge": "stryker run configs/stryker.edge.config.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "release:package": "node scripts/package-release.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "build:probe": "vite build --config configs/vite.probe.config.ts",
    "vault:reference": "node scripts/reference-vault.mjs tests/e2e/vaults/reference",
    "test:e2e": "npm run build && npm run build:probe && npm run vault:reference && wdio run tests/e2e/wdio.conf.mts"
  },
  "dependencies": {
    "@iconify/vue": "5.0.5",
    "@nuxt/ui": "4.13.0",
    "@tanstack/vue-form": "1.33.5",
    "effect": "4.1.5",
    "tailwindcss": "4.3.5",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@eslint/js": "9.39.5",
    "@iconify-json/lucide": "1.2.157",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "eslint-plugin-oxlint": "1.94.0",
    "eslint-plugin-vue": "10.12.1",
    "fallow": "3.45.0",
    "fast-check": "4.10.3",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "mocha": "12.0.3",
    "obsidian": "1.14.4",
    "oxlint": "1.94.0",
    "postcss": "8.5.33",
    "postcss-selector-parser": "7.2.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "wdio-obsidian-reporter": "3.5.0",
    "wdio-obsidian-service": "3.5.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "qs@<6.17.0": "6.17.1",
    "minimatch@>=7.0.0 <11.0.1": "11.0.9",
    "glob@>=9.0.0 <14.0.2": "14.0.6"
  }
}
