{
  "name": "weg-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Obsidian plugin for WEG advisory boards.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "vue-tsc -p tsconfig.app.json && vue-tsc -p tsconfig.node.json",
    "lint": "npm run lint:ox && npm run lint:es",
    "lint:ox": "oxlint --deny-warnings",
    "lint:es": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze": "fallow && fallow architecture",
    "build": "vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "dev": "node scripts/dev-install.mjs",
    "dev:ui": "vite --config vite.harness.config.ts",
    "build:ui": "vite build --config vite.harness.config.ts",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "release:package": "node scripts/package-release.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "4.13.0",
    "@tanstack/vue-form": "1.33.5",
    "effect": "4.1.5",
    "tailwindcss": "4.3.5",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@eslint/js": "9.39.5",
    "@iconify-json/lucide": "1.2.157",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "eslint-plugin-oxlint": "1.94.0",
    "eslint-plugin-vue": "10.12.1",
    "fallow": "3.45.0",
    "fast-check": "4.10.3",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "obsidian": "1.14.4",
    "oxlint": "1.94.0",
    "postcss": "8.5.33",
    "postcss-selector-parser": "7.2.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
